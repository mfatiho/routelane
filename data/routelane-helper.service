[Unit]
Description=RouteLane privileged routing helper
Documentation=https://github.com/routelane/routelane

[Service]
Type=dbus
BusName=io.github.routelane.Helper
ExecStart=/usr/lib/routelane/routelane-helper
User=root
Group=root
RuntimeDirectory=routelane
RuntimeDirectoryMode=0700
# Keep the ownership journal while a live kernel plan survives a helper restart.
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Only the dedicated application subtree is writable; the rest stays read-only.
ReadWritePaths=-/sys/fs/cgroup/routelane.apps
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# Mark-aware reverse-path filtering: the helper writes only a selected lane
# interface's src_valid_mark below this path (never all/default); every other
# kernel tunable stays read-only under ProtectKernelTunables=yes.
ReadWritePaths=/proc/sys/net/ipv4/conf
# An armed runtime needs the helper alive. A crash restarts it, and the
# journaled runtime resumes only after exact grant and kernel verification.
Restart=on-failure
RestartSec=1s
